root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{*.sh,*.bash,git-ignore-local}]
indent_size = 2
switch_case_indent = true

[*.ts]
indent_size = 4

[*.{json,jsonc,toml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
